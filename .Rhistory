perc_space = ~ sum(. == " ", na.rm = TRUE) / n(),
perc_na_string = ~ sum(. == "n/a", na.rm = TRUE) / n()
)
)
) %>%
pivot_longer(
cols = everything(),
names_to = c("attribute", ".value"),
names_pattern = "(.*)_(perc_.*)"
)
# Plotting the categorical data
